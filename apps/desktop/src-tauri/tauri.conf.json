{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FriesXLR",
  "version": "0.1.0",
  "identifier": "dev.friesxlr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FriesXLR",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "FriesXLR contributors",
    "shortDescription": "GoXLR control application",
    "longDescription": "A local-first desktop control application for TC-Helicon GoXLR and GoXLR Mini devices.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "FriesXLR",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
